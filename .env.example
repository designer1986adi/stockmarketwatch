# Login for the web page
APP_USERNAME=
APP_PASSWORD=
# Optional extra key for signing session cookies
SESSION_SECRET=

# Secret used by the scheduled job to call /api/check
CRON_SECRET=

# Supabase (Project Settings > API). Service role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert rules: close | intraday
ALERT_BASIS=close
# Also alert when price is within this % above the 3-month low (0 = off)
NEAR_LOW_PCT=2

# NSE, BSE, or BOTH
STOCK_EXCHANGE=BOTH
